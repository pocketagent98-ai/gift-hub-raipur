extends Node

# ==============================================================================
# COMMERCIAL-GRADE 8x8 BLOCK PUZZLE ENGINE (V7.0 — GENRE: block_puzzle)
# ==============================================================================

signal level_changed(new_level: int)
signal score_changed(new_score: int, combo: int)
signal board_updated(lines_cleared: int)
signal state_changed()
signal level_completed(lvl: int, final_score: int)
signal game_over(final_score: int)

const GENRE: String = "block_puzzle"
const GAME_TITLE: String = "__GAME_TITLE__"
const BOARD_SIZE: int = 8

var genre: String = "block_puzzle"

const PALETTE: Array[Color] = [
	Color(0.0, 0.0, 0.0, 0.0),
	Color(0.98, 0.32, 0.42),
	Color(1.00, 0.65, 0.16),
	Color(0.24, 0.86, 0.52),
	Color(0.22, 0.72, 1.00),
	Color(0.68, 0.42, 1.00),
	Color(1.00, 0.42, 0.78),
]

const PIECE_CATALOG: Array = [
	[Vector2i(0, 0)],
	[Vector2i(0, 0), Vector2i(1, 0)],
	[Vector2i(0, 0), Vector2i(0, 1)],
	[Vector2i(0, 0), Vector2i(1, 0), Vector2i(2, 0)],
	[Vector2i(0, 0), Vector2i(0, 1), Vector2i(0, 2)],
	[Vector2i(0, 0), Vector2i(1, 0), Vector2i(0, 1), Vector2i(1, 1)],
	[Vector2i(0, 0), Vector2i(1, 0), Vector2i(2, 0), Vector2i(0, 1)],
	[Vector2i(0, 0), Vector2i(1, 0), Vector2i(2, 0), Vector2i(2, 1)],
	[Vector2i(0, 0), Vector2i(1, 0), Vector2i(2, 0), Vector2i(1, 1)],
	[Vector2i(0, 0), Vector2i(1, 0), Vector2i(2, 0), Vector2i(3, 0)],
	[Vector2i(0, 0), Vector2i(0, 1), Vector2i(0, 2), Vector2i(0, 3)],
	[Vector2i(0, 0), Vector2i(1, 0), Vector2i(1, 1), Vector2i(2, 1)],
	[Vector2i(0, 0), Vector2i(1, 0), Vector2i(2, 0), Vector2i(0, 1), Vector2i(1, 1), Vector2i(2, 1), Vector2i(0, 2), Vector2i(1, 2), Vector2i(2, 2)]
]

var current_level: int = 1
var level_goal: int = 450
var target_score: int = 450
var current_score: int = 0
var best_score: int = 0
var current_combo: int = 0
var moves_made: int = 0
var moves_left: int = 30
var state: String = "playing"
var armored_block_hp: int = 4
var fever_overdrive_active: bool = false
var hammer_mode_active: bool = false

var grid_8x8: Array = []
var tray_pieces: Array = []
var juggle_hold_piece: Dictionary = {}
var juggle_swaps_remaining: int = 3
var hammer_boosters_remaining: int = 3

var last_cleared_cells: Array = []
var last_popup_text: String = ""
var last_popup_grid_pos: Vector2i = Vector2i(4, 4)
var _rng := RandomNumberGenerator.new()

func _ready() -> void:
	_rng.randomize()
	load_level(1)

func _init_empty_board() -> void:
	grid_8x8.clear()
	for r in range(BOARD_SIZE):
		var row: Array = []
		for c in range(BOARD_SIZE):
			row.append(0)
		grid_8x8.append(row)

func load_level(lvl_num: int) -> void:
	current_level = clampi(lvl_num, 1, 30)
	level_goal = 360 + (current_level - 1) * 140
	target_score = level_goal
	current_score = 0
	current_combo = 0
	moves_made = 0
	moves_left = 30
	state = "playing"
	armored_block_hp = 4
	fever_overdrive_active = false
	hammer_mode_active = false
	juggle_hold_piece = {}
	juggle_swaps_remaining = 3
	hammer_boosters_remaining = 3
	last_cleared_cells.clear()
	_init_empty_board()

	if current_level >= 2:
		var seed_rng := RandomNumberGenerator.new()
		seed_rng.seed = 9000 + current_level * 137
		var prefill := mini(14, 2 + current_level)
		for _i in range(prefill):
			var rx := seed_rng.randi_range(1, BOARD_SIZE - 2)
			var ry := seed_rng.randi_range(1, BOARD_SIZE - 2)
			grid_8x8[ry][rx] = seed_rng.randi_range(1, PALETTE.size() - 1)

	_refill_tray_pieces()
	emit_signal("level_changed", current_level)
	emit_signal("score_changed", current_score, current_combo)
	emit_signal("state_changed")

func _refill_tray_pieces() -> void:
	tray_pieces.clear()
	var empty_cells := _count_empty_cells()
	for i in range(3):
		var max_idx := PIECE_CATALOG.size() - 1
		if current_level <= 3 or empty_cells < 18:
			max_idx = mini(max_idx, 9)
		var idx := 0 if (i == 0 and empty_cells < 12) else _rng.randi_range(0, max_idx)
		var color_id := _rng.randi_range(1, PALETTE.size() - 1)
		tray_pieces.append({
			"cells": PIECE_CATALOG[idx].duplicate(),
			"color_id": color_id,
			"used": false
		})

func _count_empty_cells() -> int:
	var n := 0
	for r in range(BOARD_SIZE):
		for c in range(BOARD_SIZE):
			if int(grid_8x8[r][c]) == 0:
				n += 1
	return n

func can_place_piece(cells: Array, gx: int, gy: int) -> bool:
	if cells.is_empty():
		return false
	for cell in cells:
		var v: Vector2i = cell
		var tx := gx + v.x
		var ty := gy + v.y
		if tx < 0 or tx >= BOARD_SIZE or ty < 0 or ty >= BOARD_SIZE:
			return false
		if int(grid_8x8[ty][tx]) != 0:
			return false
	return true

func preview_clear_lines(cells: Array, gx: int, gy: int) -> Dictionary:
	var rows: Array[int] = []
	var cols: Array[int] = []
	if not can_place_piece(cells, gx, gy):
		return {"rows": rows, "cols": cols}
	var temp := []
	for r in range(BOARD_SIZE):
		temp.append(grid_8x8[r].duplicate())
	for cell in cells:
		var v: Vector2i = cell
		temp[gy + v.y][gx + v.x] = 1
	for r in range(BOARD_SIZE):
		var full := true
		for c in range(BOARD_SIZE):
			if int(temp[r][c]) == 0:
				full = false
				break
		if full:
			rows.append(r)
	for c in range(BOARD_SIZE):
		var full := true
		for r in range(BOARD_SIZE):
			if int(temp[r][c]) == 0:
				full = false
				break
		if full:
			cols.append(c)
	return {"rows": rows, "cols": cols}

func place_tray_piece(tray_idx: int, gx: int, gy: int) -> Dictionary:
	if tray_idx < 0 or tray_idx >= tray_pieces.size():
		return {"placed": false}
	var piece: Dictionary = tray_pieces[tray_idx]
	if bool(piece.get("used", true)):
		return {"placed": false}
	var cells: Array = piece["cells"]
	if not can_place_piece(cells, gx, gy):
		var aud_inv := get_node_or_null("/root/AudioDirector")
		if aud_inv != null:
			aud_inv.call("play_sfx", "invalid")
		return {"placed": false}

	var col_id := int(piece["color_id"])
	for cell in cells:
		var v: Vector2i = cell
		grid_8x8[gy + v.y][gx + v.x] = col_id

	piece["used"] = true
	moves_made += 1
	moves_left = maxi(0, moves_left - 1)
	last_cleared_cells.clear()

	var cleared := _clear_completed_rows_and_cols()
	var pts := cells.size() * 15
	var aud := get_node_or_null("/root/AudioDirector")

	if cleared > 0:
		current_combo = mini(8, current_combo + 1)
		fever_overdrive_active = (current_combo >= 3)
		var mult := 2 if fever_overdrive_active else 1
		pts += cleared * cleared * 120 * current_combo * mult
		last_popup_text = ("FEVER +%d!" % pts) if fever_overdrive_active else ("+%d  x%d" % [pts, current_combo])
		if aud != null:
			aud.call("play_sfx", "line_clear", current_combo)
	else:
		current_combo = 0
		fever_overdrive_active = false
		last_popup_text = "+%d" % pts
		if aud != null:
			aud.call("play_sfx", "place_block", 1)

	last_popup_grid_pos = Vector2i(gx, gy)
	current_score += pts
	if current_score > best_score:
		best_score = current_score

	var all_used := true
	for p in tray_pieces:
		if not bool(p["used"]):
			all_used = false
			break
	if all_used:
		_refill_tray_pieces()

	emit_signal("score_changed", current_score, current_combo)
	emit_signal("board_updated", cleared)
	emit_signal("state_changed")

	if current_score >= level_goal:
		state = "won"
		var save_mgr := get_node_or_null("/root/SaveManager")
		if save_mgr != null:
			save_mgr.call("add_coins", 50)
		if aud != null:
			aud.call("play_sfx", "victory", 5)
		emit_signal("level_completed", current_level, current_score)
	elif not _has_any_valid_move():
		state = "lost"
		emit_signal("game_over", current_score)

	return {"placed": true, "lines_cleared": cleared, "score_gained": pts}

func _clear_completed_rows_and_cols() -> int:
	var full_rows: Array[int] = []
	var full_cols: Array[int] = []
	for r in range(BOARD_SIZE):
		var full := true
		for c in range(BOARD_SIZE):
			if int(grid_8x8[r][c]) == 0:
				full = false
				break
		if full:
			full_rows.append(r)
	for c in range(BOARD_SIZE):
		var full := true
		for r in range(BOARD_SIZE):
			if int(grid_8x8[r][c]) == 0:
				full = false
				break
		if full:
			full_cols.append(c)

	for r in full_rows:
		for c in range(BOARD_SIZE):
			last_cleared_cells.append({"pos": Vector2i(c, r), "color_id": int(grid_8x8[r][c])})
			grid_8x8[r][c] = 0
	for c in full_cols:
		for r in range(BOARD_SIZE):
			if int(grid_8x8[r][c]) != 0:
				last_cleared_cells.append({"pos": Vector2i(c, r), "color_id": int(grid_8x8[r][c])})
				grid_8x8[r][c] = 0
	return full_rows.size() + full_cols.size()

func _has_any_valid_move() -> bool:
	for p in tray_pieces:
		if bool(p["used"]):
			continue
		var cells: Array = p["cells"]
		for r in range(BOARD_SIZE):
			for c in range(BOARD_SIZE):
				if can_place_piece(cells, c, r):
					return true
	return false

func use_juggle_swap() -> bool:
	if juggle_swaps_remaining <= 0:
		return false
	for i in range(tray_pieces.size()):
		if not bool(tray_pieces[i]["used"]):
			juggle_swaps_remaining -= 1
			var active_p: Dictionary = tray_pieces[i]
			if juggle_hold_piece.is_empty():
				juggle_hold_piece = active_p
				tray_pieces[i] = {"cells": PIECE_CATALOG[0].duplicate(), "color_id": _rng.randi_range(1, 6), "used": false}
			else:
				var prev := juggle_hold_piece
				juggle_hold_piece = active_p
				tray_pieces[i] = prev
			var aud := get_node_or_null("/root/AudioDirector")
			if aud != null:
				aud.call("play_sfx", "swap", 2)
			emit_signal("state_changed")
			return true
	return false

func use_hammer_at(gx: int, gy: int) -> bool:
	if hammer_boosters_remaining <= 0:
		return false
	hammer_boosters_remaining -= 1
	hammer_mode_active = false
	last_cleared_cells.clear()
	for dy in range(-1, 2):
		for dx in range(-1, 2):
			var tx := gx + dx
			var ty := gy + dy
			if tx >= 0 and tx < BOARD_SIZE and ty >= 0 and ty < BOARD_SIZE and int(grid_8x8[ty][tx]) != 0:
				last_cleared_cells.append({"pos": Vector2i(tx, ty), "color_id": int(grid_8x8[ty][tx])})
				grid_8x8[ty][tx] = 0
	var aud := get_node_or_null("/root/AudioDirector")
	if aud != null:
		aud.call("play_sfx", "armor_crack", 3)
	emit_signal("board_updated", 1)
	emit_signal("state_changed")
	return true

func use_booster(kind: String) -> bool:
	if kind == "hammer":
		return use_hammer_at(3, 3)
	return use_juggle_swap()

func add_moves(count: int) -> void:
	moves_left += maxi(1, count)
	juggle_swaps_remaining += 1
	emit_signal("state_changed")

func apply_hit_to_target(hit_power: int = 1) -> Dictionary:
	armored_block_hp = maxi(0, armored_block_hp - maxi(1, hit_power))
	var shattered := (armored_block_hp == 0)
	if shattered:
		current_score += 80
		armored_block_hp = 4
	else:
		current_score += 20
	var aud := get_node_or_null("/root/AudioDirector")
	if aud != null:
		aud.call("play_sfx", "armor_crack", 2)
	emit_signal("score_changed", current_score, current_combo)
	emit_signal("state_changed")
	return {"remaining_hp": armored_block_hp, "shattered": shattered, "score": current_score}

func load_single_chunk(chunk_id: int) -> void:
	load_level(clampi(chunk_id, 1, 30))

func test_stitched_chunks(chunk_order: Array) -> void:
	for cid in chunk_order:
		load_single_chunk(int(cid))

func get_snapshot() -> Dictionary:
	var flat_cells: Array = []
	for r in range(BOARD_SIZE):
		for c in range(BOARD_SIZE):
			flat_cells.append(int(grid_8x8[r][c]))
	return {
		"genre": GENRE,
		"level": current_level,
		"score": current_score,
		"target_score": target_score,
		"combo": current_combo,
		"moves_made": moves_made,
		"moves_left": moves_left,
		"state": state,
		"cells": flat_cells,
		"tray_count": tray_pieces.size(),
	}

func bot_play_step() -> String:
	for i in range(tray_pieces.size()):
		if bool(tray_pieces[i]["used"]):
			continue
		var cells: Array = tray_pieces[i]["cells"]
		var best_pos := Vector2i(-1, -1)
		var best_clears := -1
		for r in range(BOARD_SIZE):
			for c in range(BOARD_SIZE):
				if can_place_piece(cells, c, r):
					var pv := preview_clear_lines(cells, c, r)
					var clr: int = pv["rows"].size() + pv["cols"].size()
					if clr > best_clears:
						best_clears = clr
						best_pos = Vector2i(c, r)
		if best_pos.x >= 0:
			var res := place_tray_piece(i, best_pos.x, best_pos.y)
			return "BOT_PLACED_BLOCK tray=%d at (%d,%d) | Cleared=%d | Score=%d" % [i, best_pos.x, best_pos.y, int(res.get("lines_cleared", 0)), current_score]
	return "BOT_NO_MOVE"

func step_mechanics_lab_test() -> String:
	load_level(1)
	for c in range(7):
		grid_8x8[0][c] = 2
	tray_pieces[0] = {"cells": [Vector2i(0, 0)], "color_id": 4, "used": false}
	var res := place_tray_piece(0, 7, 0)
	var hit_res := apply_hit_to_target(1)
	return "MECHANICS_LAB_PASS: Placed=%s | LinesCleared=%d | ArmoredHP=%d | Score=%d" % [str(res.get("placed", false)), int(res.get("lines_cleared", 0)), int(hit_res.get("remaining_hp", 0)), current_score]
