extends Node

# ==============================================================================
# COMMERCIAL-GRADE 8x8 MATCH-3 CRYSTAL ENGINE (V6.0 — GENRE: match_3)
# ==============================================================================

signal level_changed(new_level: int)
signal score_changed(new_score: int, combo: int)
signal board_updated(lines_cleared: int)
signal state_changed()
signal level_completed(lvl: int, final_score: int)
signal game_over(final_score: int)

const GENRE: String = "match_3"
const GAME_TITLE: String = "__GAME_TITLE__"
const BOARD_SIZE: int = 8

const PALETTE: Array[Color] = [
	Color(0.0, 0.0, 0.0, 0.0),
	Color(0.98, 0.30, 0.40),
	Color(1.00, 0.72, 0.16),
	Color(0.22, 0.86, 0.50),
	Color(0.20, 0.70, 1.00),
	Color(0.72, 0.40, 1.00),
	Color(1.00, 0.44, 0.80),
]

var current_level: int = 1
var level_goal: int = 400
var moves_left: int = 20
var moves_made: int = 0
var current_score: int = 0
var best_score: int = 0
var current_combo: int = 0
var grid_8x8: Array = []
var selected_cell: Vector2i = Vector2i(-1, -1)
var last_cleared_cells: Array = []
var last_popup_text: String = ""
var last_popup_grid_pos: Vector2i = Vector2i(4, 4)
var _rng := RandomNumberGenerator.new()

func _ready() -> void:
	_rng.randomize()
	load_level(1)

func load_level(lvl_num: int) -> void:
	current_level = clampi(lvl_num, 1, 30)
	level_goal = 360 + (current_level - 1) * 140
	moves_left = max(14, 24 - int(current_level / 4))
	moves_made = 0
	current_score = 0
	current_combo = 0
	selected_cell = Vector2i(-1, -1)
	last_cleared_cells.clear()
	_generate_playable_board()
	emit_signal("level_changed", current_level)
	emit_signal("score_changed", current_score, current_combo)
	emit_signal("state_changed")

func _generate_playable_board() -> void:
	grid_8x8.clear()
	var color_count := mini(6, 4 + int(current_level / 6))
	for r in range(BOARD_SIZE):
		var row: Array = []
		for c in range(BOARD_SIZE):
			var col := _rng.randi_range(1, color_count)
			while (c >= 2 and int(row[c - 1]) == col and int(row[c - 2]) == col) or (r >= 2 and int(grid_8x8[r - 1][c]) == col and int(grid_8x8[r - 2][c]) == col):
				col = (col % color_count) + 1
			row.append(col)
		grid_8x8.append(row)
	if find_first_valid_swap().is_empty():
		grid_8x8[0][0] = 1
		grid_8x8[0][1] = 1
		grid_8x8[1][2] = 1

func try_swap(a: Vector2i, b: Vector2i) -> Dictionary:
	if abs(a.x - b.x) + abs(a.y - b.y) != 1:
		return {"swapped": false}
	if a.x < 0 or a.x >= BOARD_SIZE or a.y < 0 or a.y >= BOARD_SIZE:
		return {"swapped": false}
	if b.x < 0 or b.x >= BOARD_SIZE or b.y < 0 or b.y >= BOARD_SIZE:
		return {"swapped": false}

	var tmp: int = int(grid_8x8[a.y][a.x])
	grid_8x8[a.y][a.x] = grid_8x8[b.y][b.x]
	grid_8x8[b.y][b.x] = tmp

	var matches := _find_matches()
	if matches.is_empty():
		grid_8x8[b.y][b.x] = grid_8x8[a.y][a.x]
		grid_8x8[a.y][a.x] = tmp
		var aud_inv := get_node_or_null("/root/AudioDirector")
		if aud_inv != null:
			aud_inv.call("play_sfx", "invalid")
		return {"swapped": false}

	moves_left -= 1
	moves_made += 1
	current_combo = 0
	var total_cleared := 0
	var total_pts := 0
	last_cleared_cells.clear()

	while not matches.is_empty():
		current_combo = mini(8, current_combo + 1)
		for m_pos in matches:
			var p: Vector2i = m_pos
			last_cleared_cells.append({"pos": p, "color_id": int(grid_8x8[p.y][p.x])})
			grid_8x8[p.y][p.x] = 0
		total_cleared += matches.size()
		total_pts += matches.size() * 40 * current_combo
		_apply_gravity_and_refill()
		matches = _find_matches()

	current_score += total_pts
	if current_score > best_score:
		best_score = current_score
	last_popup_text = "+%d  x%d" % [total_pts, current_combo]
	last_popup_grid_pos = b

	var aud := get_node_or_null("/root/AudioDirector")
	if aud != null:
		aud.call("play_sfx", "match", current_combo)

	selected_cell = Vector2i(-1, -1)
	emit_signal("score_changed", current_score, current_combo)
	emit_signal("board_updated", total_cleared)
	emit_signal("state_changed")

	if current_score >= level_goal:
		var save_mgr := get_node_or_null("/root/SaveManager")
		if save_mgr != null:
			save_mgr.call("add_coins", 50)
		if aud != null:
			aud.call("play_sfx", "victory", 5)
		emit_signal("level_completed", current_level, current_score)
	elif moves_left <= 0:
		emit_signal("game_over", current_score)

	return {"swapped": true, "cleared": total_cleared, "score_gained": total_pts}

func _find_matches() -> Array:
	var hit: Dictionary = {}
	for r in range(BOARD_SIZE):
		var run_col := int(grid_8x8[r][0])
		var run_start := 0
		for c in range(1, BOARD_SIZE + 1):
			var cur := int(grid_8x8[r][c]) if c < BOARD_SIZE else -1
			if cur == run_col and run_col > 0:
				continue
			if c - run_start >= 3 and run_col > 0:
				for k in range(run_start, c):
					hit[Vector2i(k, r)] = true
			run_col = cur
			run_start = c

	for c in range(BOARD_SIZE):
		var run_col := int(grid_8x8[0][c])
		var run_start := 0
		for r in range(1, BOARD_SIZE + 1):
			var cur := int(grid_8x8[r][c]) if r < BOARD_SIZE else -1
			if cur == run_col and run_col > 0:
				continue
			if r - run_start >= 3 and run_col > 0:
				for k in range(run_start, r):
					hit[Vector2i(c, k)] = true
			run_col = cur
			run_start = r
	return hit.keys()

func _apply_gravity_and_refill() -> void:
	var color_count := mini(6, 4 + int(current_level / 6))
	for c in range(BOARD_SIZE):
		var write_r := BOARD_SIZE - 1
		for r in range(BOARD_SIZE - 1, -1, -1):
			if int(grid_8x8[r][c]) > 0:
				grid_8x8[write_r][c] = grid_8x8[r][c]
				if write_r != r:
					grid_8x8[r][c] = 0
				write_r -= 1
		while write_r >= 0:
			grid_8x8[write_r][c] = _rng.randi_range(1, color_count)
			write_r -= 1

func find_first_valid_swap() -> Array:
	for r in range(BOARD_SIZE):
		for c in range(BOARD_SIZE):
			for d in [Vector2i(1, 0), Vector2i(0, 1)]:
				var nb := Vector2i(c + d.x, r + d.y)
				if nb.x < BOARD_SIZE and nb.y < BOARD_SIZE:
					var tmp: int = int(grid_8x8[r][c])
					grid_8x8[r][c] = grid_8x8[nb.y][nb.x]
					grid_8x8[nb.y][nb.x] = tmp
					var ok := not _find_matches().is_empty()
					grid_8x8[nb.y][nb.x] = grid_8x8[r][c]
					grid_8x8[r][c] = tmp
					if ok:
						return [Vector2i(c, r), nb]
	return []

func bot_play_step() -> String:
	var pair := find_first_valid_swap()
	if pair.size() == 2:
		var res := try_swap(pair[0], pair[1])
		return "BOT_SWAPPED %s<->%s | Cleared=%d | Score=%d" % [str(pair[0]), str(pair[1]), int(res.get("cleared", 0)), current_score]
	_generate_playable_board()
	return "BOT_RESHUFFLED"

func step_mechanics_lab_test() -> String:
	load_level(1)
	var pair := find_first_valid_swap()
	if pair.size() == 2:
		var res := try_swap(pair[0], pair[1])
		return "MECHANICS_LAB_PASS: Swapped=%s | Cleared=%d | Score=%d" % [str(res.get("swapped", false)), int(res.get("cleared", 0)), current_score]
	return "MECHANICS_LAB_FAIL"
