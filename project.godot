; Engine configuration file.
; Configured for Godot 4.7.2 (Stable) — V2.0 Commercial Studio Edition
; CRITICAL: QA Bot is NOT in [autoload]. Production APK/AAB is 100% free of test bots.

config_version=5

[application]

config/name="Autonomous AI Studio Game V2"
config/description="Commercial-Grade Polished 3D Game (Godot 4.7.2)"
config/version="2.0.1"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

AppConfig="*res://scripts/app_config.gd"
AnalyticsManager="*res://scripts/analytics_manager.gd"
SaveManager="*res://scripts/save_manager.gd"
AudioDirector="*res://scripts/audio_director.gd"
MonetizationManager="*res://scripts/monetization_manager.gd"
StudioThemeAndVFX="*res://scripts/procedural_polish_theme_and_vfx.gd"
GameManager="*res://scripts/game_manager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[physics]

# Verified 60Hz physics tick lock: physics_ticks_per_second=60
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
