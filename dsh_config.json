{
  "schema_version": "7.0",
  "harness": "deepseek-harness",
  "mode": "primary_and_only_coding_agent",
  "opencode_enabled": false,
  "agent_harness": "deepseek-harness-nvidia-private",
  "provider": "nvidia_nim",
  "api_base": "https://integrate.api.nvidia.com/v1",
  "api_key_env": "NVIDIA_API_KEY",
  "models": {
    "architect": "nvidia/nemotron-3-ultra-550b-a55b",
    "core_coder": "nvidia/nemotron-4-340b-instruct",
    "balanced_coder": "nvidia/nemotron-3-super-120b-a12b",
    "fast_patch": "nvidia/nemotron-3.5-lightning-30b-a3b",
    "safety": "nvidia/nemotron-3.5-content-safety"
  },
  "rate_limit": {
    "min_delay_sec": 3.5,
    "backoff_schedule_sec": [15, 30, 60]
  },
  "skills_router": ".agents/skills/SKILL_ROUTER.json"
}
